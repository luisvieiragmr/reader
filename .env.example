# Created by `npx convex dev`. No Astryx env vars are required.
CONVEX_AGENT_MODE=anonymous
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Set on the Convex deployment (not Next.js): Clerk Frontend API URL
# Example: https://verb-noun-00.clerk.accounts.dev
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://….clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=

# MCP HTTP server (see mcp/README.md)
# Next.js (.env.local / Vercel): bearer token for /api/mcp
MCP_SECRET=
# Convex deployment (npx convex env set …) — same secret + owner tokenIdentifier:
# MCP_SECRET=
# MCP_USER_TOKEN_IDENTIFIER=
