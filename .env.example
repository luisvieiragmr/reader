# Created by `npx convex dev`. No Astryx env vars are required.
CONVEX_AGENT_MODE=anonymous
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# MCP OAuth: set both values in Next.js AND the matching Convex deployment.
# Issuer must match the Clerk instance used by the web app.
CLERK_JWT_ISSUER_DOMAIN=
# Production: https://YOUR-APP.vercel.app/api/mcp
MCP_RESOURCE_URL=http://localhost:3000/api/mcp
